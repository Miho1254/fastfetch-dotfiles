{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.local/share/fastfetch/presets/elaina.png",
    "type": "kitty",
    "height": 20,
    "padding": {
      "top": 2
    }
  },
  "display": {
    //"separator": " ➜  "
    "separator": "\u001b[38;2;122;162;247m ➜ \u001b[0m"
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "os",
      "format": "{2}",
      "key": "OS   ",
      "keyColor": "#7aa2f7", // = color1
    },
    {
      "type": "kernel",
      "format": "{2}",
      "key": " ├  ",
      "keyColor": "#7aa2f7",
    },
    {
      "type": "packages",
      "format": "{} (pacman)",
      "key": " ├ 󰏖 ",
      "keyColor": "#7aa2f7",
    },
    {
      "type": "shell",
      "format": "{1}",
      "key": " └  ",
      "keyColor": "#7aa2f7",
    },
    "break",
    {
      "type": "wm",
      "format": "{1}",
      "key": "WM   ",
      "keyColor": "#bb9af7",
    },
    {
      "type": "wmtheme",
      "key": " ├ 󰉼 ",
      "keyColor": "#bb9af7",
    },
    {
      "type": "icons",
      "key": " ├ 󰀻 ",
      "keyColor": "#bb9af7",
    },
    {
      "type": "cursor",
      "key": " ├  ",
      "keyColor": "#bb9af7",
    },
    {
      "type": "terminal",
      "format": "{5}",
      "key": " ├  ",
      "keyColor": "#bb9af7",
    },
    {
      "type": "terminalfont",
      "key": " └  ",
      "keyColor": "#bb9af7",
    },
    "break",
    {
      "type": "host",
      "format": "{1}",
      "key": "PC   ",
      "keyColor": "#7dcfff",
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " ├  ",
      "keyColor": "#7dcfff",
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": " ├ 󰢮 ",
      "keyColor": "#7dcfff",
    },
    {
      "type": "memory",
      "key": " ├  ",
      "keyColor": "#7dcfff",
    },
    {
      "type": "swap",
      "key": " ├ 󰓡 ",
      "keyColor": "#7dcfff",
    },
    {
      "type": "disk",
      "key": " ├ 󰋊 ",
      "keyColor": "#7dcfff",
    },
    {
      "type": "monitor",
      "format": "{2}x{3} @ {7} Hz",
      "key": " └  ",
      "keyColor": "#7dcfff",
    },
    "break",
    "break",
  ]
}
